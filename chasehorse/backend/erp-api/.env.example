# Server-only settings. Put real values in your deployment secret manager, never in Git.
SUPABASE_JWT_ISSUER=https://phxybimufcrsnxfepiuz.supabase.co/auth/v1
SPRING_DATASOURCE_URL=jdbc:postgresql://db.phxybimufcrsnxfepiuz.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<least-privilege-app-user>
SPRING_DATASOURCE_PASSWORD=<set-a-rotated-secret>
FLYWAY_ENABLED=false
DB_POOL_SIZE=5
PORT=8080

# Traqo Tracking API Proxy Settings (HTTP Basic Auth, server-only)
TRAQO_BASE_URL=https://dashboard.traqo.in
TRAQO_USERNAME=
TRAQO_PASSWORD=

# Transactional e-mail (Zoho Mail SMTP) — task accepted / worker assigned / ticket raised.
# Create an app-specific password in Zoho for the tech.support@ mailbox; never use the account password.
# India data-centre Zoho accounts use smtp.zoho.in, global ones smtp.zoho.com.
MAIL_ENABLED=false
MAIL_HOST=smtp.zoho.in
MAIL_PORT=465
MAIL_USERNAME=tech.support@chasehorse.com
MAIL_PASSWORD=<zoho-app-password>
MAIL_FROM=tech.support@chasehorse.com
MAIL_FROM_NAME=ChaseHorse Support
MAIL_ADMIN_CC=chasehorseadmin@gmail.com
# Public URL of the web app, used for links inside e-mails
APP_PUBLIC_URL=https://<your-web-app-domain>

# Field workers see / accept open tasks within this many km of their location or zone
WORKER_TASK_RADIUS_KM=100

# Enquiry Management System (website forms)
# Mailbox that sends the 6-digit e-mail verification codes (Zoho app password)
NOREPLY_MAIL_USERNAME=noreply@chasehorse.com
NOREPLY_MAIL_PASSWORD=<zoho-app-password-for-noreply>
# Receives an alert with the full details of every new enquiry
ENQUIRY_ALERT_TO=shravan.vibhas@chasehorse.com
# Long random secret for code hashes / verification tokens (openssl rand -base64 48)
ENQUIRY_OTP_SECRET=<long-random-secret>
# Local development only: print codes to the log instead of e-mailing them
ENQUIRY_LOG_CODES_FOR_DEVELOPMENT=false
