# ── Railway / Render Backend Environment Variables ─────────────────
# Set these in your hosting platform's dashboard — NEVER commit real values.

PORT=8080

# Supabase PostgreSQL (IPv4-compatible connection pooler for cloud platforms like Render / Railway)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.phxybimufcrsnxfepiuz
SPRING_DATASOURCE_PASSWORD=3yRdrRkI1ZRl6wiv
DB_POOL_SIZE=10
FLYWAY_ENABLED=true
HIBERNATE_DDL_AUTO=none

# JWT Issuer (Supabase Auth)
SUPABASE_JWT_ISSUER=https://phxybimufcrsnxfepiuz.supabase.co/auth/v1

# CORS — your Vercel frontend URL(s)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# Transactional Email (Zoho SMTP)
MAIL_ENABLED=true
MAIL_HOST=smtp.zoho.in
MAIL_PORT=465
MAIL_USERNAME=tech.support@chasehorse.com
MAIL_PASSWORD=<zoho-app-password>
MAIL_FROM=tech.support@chasehorse.com
MAIL_FROM_NAME=ChaseHorse Support
MAIL_ADMIN_CC=ems.admin@chasehorse.com
APP_PUBLIC_URL=https://your-app.vercel.app

# Enquiry OTP
NOREPLY_MAIL_USERNAME=noreply@chasehorse.com
NOREPLY_MAIL_PASSWORD=<zoho-app-password-for-noreply>
ENQUIRY_ALERT_TO=shravan.vibhas@chasehorse.com
ENQUIRY_OTP_SECRET=<long-random-secret>
