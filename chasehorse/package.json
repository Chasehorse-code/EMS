{
  "name": "chasehorse-admin-dashboard",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "packages/*"
  ],
  "version": "0.1.0",
  "description": "ChaseHorse field-task management admin dashboard — frontend prototype (demo data only)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "npx tsx scripts/test-parity-suite.mjs && node scripts/verify-mobile-openapi.mjs",
    "verify:mobile-openapi": "node scripts/verify-mobile-openapi.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@chasehorse/api-client": "file:packages/api-client",
    "@chasehorse/design-tokens": "file:packages/design-tokens",
    "@chasehorse/domain": "file:packages/domain",
    "@floating-ui/react": "^0.27.20",
    "@supabase/supabase-js": "^2.118.0",
    "@types/leaflet": "^1.9.22",
    "canvas-confetti": "^1.9.4",
    "d3-geo": "^3.1.2",
    "framer-motion": "^11.18.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.7.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.3",
    "vite": "^7.3.8"
  }
}
